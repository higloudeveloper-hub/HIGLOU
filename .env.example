# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ECONOMY_MODEL=gpt-4o-mini
OPENAI_ADVANCED_MODEL=gpt-4o

# Monthly operating target
MONTHLY_PRODUCT_TARGET=500
MONTHLY_BUDGET_WARNING_USD=75
MONTHLY_BUDGET_LIMIT_USD=100

# OpenAI pricing estimates per million tokens (editable; not hard-coded in business logic)
OPENAI_INPUT_PRICE_PER_MILLION=1
OPENAI_CACHED_INPUT_PRICE_PER_MILLION=0.5
OPENAI_OUTPUT_PRICE_PER_MILLION=6
OPENAI_ECONOMY_INPUT_PRICE_PER_MILLION=0.15
OPENAI_ECONOMY_CACHED_INPUT_PRICE_PER_MILLION=0.075
OPENAI_ECONOMY_OUTPUT_PRICE_PER_MILLION=0.6

# Google Vision pricing
GOOGLE_VISION_FREE_UNITS_MONTHLY=1000
GOOGLE_VISION_PRICE_PER_1000_UNITS=1.50

# Infrastructure estimates
SUPABASE_MONTHLY_BASE_COST=25
VERCEL_MONTHLY_BASE_COST=20
DOMAIN_MISC_MONTHLY_COST=3

# Analysis limits
DEFAULT_IMAGES_PER_PRODUCT=8
MAX_IMAGES_PER_PRODUCT=12
GOOGLE_VISION_MAX_IMAGES_PER_PRODUCT=4
MAX_RETRIES_PER_ANALYSIS=2

# Google Cloud Vision
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=
GOOGLE_VISION_ENABLED=true
GOOGLE_VISION_MODE=fallback
GOOGLE_VISION_MAX_IMAGES=4

# Image analysis
MAX_ANALYSIS_IMAGES=12
MAX_IMAGE_SIZE_MB=10
ENABLE_BARCODE_SCANNING=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Higlou owner accounts — Don Baratón publish/import is locked to these emails
HIGLOU_OWNER_EMAILS=higloudeveloper@gmail.com

# Don Baratón storefront (www.donbaraton.shop) — same eBay CSV as Admin → Importar eBay
# See docs/don-baraton-ebay-csv-sync.md
DON_BARATON_API_URL=https://www.donbaraton.shop
DON_BARATON_IMPORT_TOKEN=
DON_BARATON_SYNC_ENABLED=true
NEXT_PUBLIC_DON_BARATON_URL=https://www.donbaraton.shop
# Legacy aliases (still supported):
# DON_BARATON_URL=
# DON_BARATON_SYNC_TOKEN=

# eBay Sell API OAuth (per-seller Connect store)
# Create app at https://developer.ebay.com/ — start with sandbox
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName value from eBay Developer (used as OAuth redirect_uri)
EBAY_RU_NAME=
# Any secret ≥32 characters — used to encrypt refresh tokens at rest
EBAY_TOKEN_ENCRYPTION_KEY=
# Marketplace Account Deletion (required for public apps)
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=
# EBAY_ACCOUNT_DELETION_ENDPOINT=https://higlou-magic-studio-psi.vercel.app/api/ebay/account-deletion

# Amazon Selling Partner API (per-seller Connect Amazon)
# Create an SP-API app in Seller Central → Apps and Services → Develop Apps
AMAZON_SP_API_ENV=production
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_APP_ID=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
# Draft apps need version=beta on the consent URL. Set to 0 after Appstore publish.
AMAZON_APP_DRAFT=1
# Optional; falls back to EBAY_TOKEN_ENCRYPTION_KEY
# AMAZON_TOKEN_ENCRYPTION_KEY=
